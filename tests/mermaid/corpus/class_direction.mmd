%% direction LR in a class diagram
%% expect: nodes=3 edges=3
classDiagram
    direction LR
    class Student {
        -idCard : IdCard
    }
    class IdCard {
        -id : int
        -name : string
    }
    class Bike {
        -id : int
        -name : string
    }
    Student "1" --o "1" IdCard : carries
    Student "1" --o "1" Bike : rides
    IdCard ..> Bike
