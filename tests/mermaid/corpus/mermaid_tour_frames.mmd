%% A diagram of the Mermaid tour (examples/mermaid)
%% expect: participants=2 messages=6 notes=1 frames=3
sequenceDiagram
    participant C as Client
    participant S as Server
    C->>S: request
    alt cached
        S-->>C: cached answer
    else not cached
        loop each page
            S->>S: fetch a page
        end
        S-->>C: fresh answer
    end
    Note over C,S: the connection stays open
    par notify
        S-)C: event
    and log
        S-)S: write the log
    end
